      "name": "PRODUCTS",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "tests",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.collectionVariables.set('productId', jsonData.product._id);",
                  "  console.log('Product ID saved:', jsonData.product._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gaming Laptop Pro\",\n  \"sku\": \"LAPTOP-001\",\n  \"price\": 1299.99,\n  \"compareAtPrice\": 1499.99,\n  \"cost\": 800,\n  \"type\": \"physical\",\n  \"weight\": 2.5,\n  \"weightUnit\": \"kg\",\n  \"images\": [\"https://cdn.example.com/laptop.jpg\"],\n  \"tags\": [\"electronics\", \"gaming\", \"laptop\"],\n  \"vendor\": \"TechBrand\",\n  \"description\": \"High-performance gaming laptop with RTX 4090\"\n}",
              "type": "application/json"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?skip=0&limit=50&status=active",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "status",
                  "value": "active"
