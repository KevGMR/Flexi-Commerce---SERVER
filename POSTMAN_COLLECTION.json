    },
    {
      "key": "userEmail",
      "value": "john@example.com",
      "type": "string"
    },
    {
      "key": "organizationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizationSlug",
      "value": "",
      "type": "string"
    }
  ]
}
