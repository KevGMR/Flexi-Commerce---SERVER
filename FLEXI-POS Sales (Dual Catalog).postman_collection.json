  "item": [
    {
      "name": "1. Create Sale (Mixed Items)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  var jsonData = pm.response.json();",
              "  pm.environment.set('saleId', jsonData.data.saleId);",
              "  pm.environment.set('receiptNumber', jsonData.data.receiptNumber);",
              "  console.log('Sale ID: ' + jsonData.data.saleId);",
              "  console.log('Receipt: ' + jsonData.data.receiptNumber);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"locationId\": \"696fb09d006f8323184b8946\",\n  \"items\": [\n    {\n      \"type\": \"flexi\",\n      \"productId\": \"696fddca006f8323184b897c\",\n      \"quantity\": 2,\n      \"unitPrice\": 15.00,\n      \"discount\": 0,\n      \"taxAmount\": 2.40\n    },\n    {\n      \"type\": \"shopify\",\n      \"shopifyVariantId\": \"gid://shopify/ProductVariant/52040931246447\",\n      \"productName\": \"Shopify Blue Jeans\",\n      \"sku\": \"SHOP-JEANS-BLU-32\",\n      \"quantity\": 1,\n      \"unitPrice\": 45.00,\n      \"discount\": 5.00,\n      \"taxAmount\": 3.20\n    }\n  ],\n  \"customerId\": null,\n  \"paymentMethod\": \"cash\",\n  \"paymentStatus\": \"completed\",\n  \"notes\": \"Test sale\",\n  \"tags\": [\"test\"],\n  \"idempotencyKey\": \"unique-idempotency-key-11\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sales",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales"
          ]
        },
        "description": "Create a sale with items from both FLEXI catalog and Shopify. Automatically updates inventory for both systems."
      },
      "response": []
    },
